+def _normalize_llm_base_url(value: str) -> str:
+    normalized = value.strip().rstrip("/")
+    while normalized.lower().endswith("/v1/v1"):
+        normalized = normalized[:-3]
+    if not normalized.lower().endswith("/v1"):
+        normalized = f"{normalized}/v1"
+    return normalized
