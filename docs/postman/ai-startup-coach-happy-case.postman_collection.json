      "name": "10 Get Lean Canvas",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/startups/{{startupId}}/documents/lean_canvas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "startups",
            "{{startupId}}",
            "documents",
            "lean_canvas"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('lean canvas document exists', function () {",
              "  pm.response.to.have.status(200);",
              "  const json = pm.response.json();",
              "  pm.expect(json.doc_type).to.eql('lean_canvas');",
              "  pm.expect(json.version).to.be.greaterThan(0);",
              "  pm.expect(json.content.problem).to.be.a('string').and.not.empty;",
              "});"
            ]
          }
        }
      ]
    },
