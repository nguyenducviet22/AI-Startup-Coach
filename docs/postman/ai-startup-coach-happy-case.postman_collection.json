              "  pm.response.to.have.status(200);",
              "  const json = pm.response.json();",
              "  pm.expect(json.documents.length).to.be.greaterThan(0);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Set Stage To BMC",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
