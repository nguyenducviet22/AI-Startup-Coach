DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/coaching

# Set APP_ENV=production (or another non-local value) in deployed environments.
# 9Router is OpenAI-compatible and exposes its API under /v1.
APP_ENV=local
LLM_PROXY_BASE_URL=http://localhost:20128/v1
LLM_PROXY_API_KEY=replace-with-9router-credential
# Use the model ID configured in 9Router, typically provider/model.
LLM_PROXY_MODEL=replace-with-9router-model-id
LLM_PROXY_MAX_TOKENS=1024

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=replace-with-openrouter-model-slug
OPENROUTER_MAX_TOKENS=1024
OPENROUTER_HTTP_REFERER=http://localhost:8000
OPENROUTER_X_TITLE=AI Startup Coach

CHAT_HISTORY_LIMIT=20
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1.0

AGENTOPS_PRICING_ENABLED=true

# Research Agent. TAVILY_API_KEY is required only for live research requests;
# fixture tests inject a fake provider instead.
RESEARCH_ENABLED=true
RESEARCH_PROVIDER=tavily
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
RESEARCH_PROVIDER_TIMEOUT_SECONDS=15.0
RESEARCH_PROVIDER_MAX_RETRIES=1
RESEARCH_SESSION_HOURLY_CALL_LIMIT=8
RESEARCH_SESSION_DAILY_CREDIT_LIMIT=20
RESEARCH_USER_HOURLY_CALL_LIMIT=20
RESEARCH_USER_DAILY_CREDIT_LIMIT=60
RESEARCH_CACHE_TTL_GENERAL_SECONDS=21600
RESEARCH_CACHE_TTL_NEWS_SECONDS=3600
RESEARCH_CACHE_TTL_PRICING_SECONDS=3600
RESEARCH_CACHE_TTL_LEGAL_SECONDS=3600
RESEARCH_DEFAULT_SEARCH_DEPTH=basic
RESEARCH_MAX_RESULTS=5
RESEARCH_PRICING_ENABLED=true
TAVILY_BASIC_SEARCH_CREDITS=1
TAVILY_ADVANCED_SEARCH_CREDITS=2
TAVILY_EXTRACT_CREDITS_PER_FIVE_URLS=1
RESEARCH_ERROR_ALERT_THRESHOLD=0.5
RESEARCH_ERROR_ALERT_WINDOW_SECONDS=300

JWT_SECRET=replace-with-a-local-jwt-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
